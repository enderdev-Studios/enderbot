{
  "name": "enderbot",
  "version": "3.1.0",
  "main": "./dist/index.js",
  "keywords": [],
  "author": "enderdev-v",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "scripts": {
    "test": "tsc --traceResolution",
    "start": "tsx ./src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "dev": "tsx watch ./src/index.ts",
    "build": "node ./scripts/CleanBuild.js && tsc",
    "watch": "tsc -w",
    "logs": "node ./scripts/Cleanlogs.js",
    "start:prod": "node ./dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.5.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "chalk": "5.3.0",
    "discord-arts": "0.6.1",
    "dotenv": "16.4.5",
    "ms": "2.1.3",
    "seyfert": "5.0.0",
    "ts-pattern": "^5.9.0",
    "yunaforseyfert": "^1.1.3"
  },
  "imports": {
    "#enderbot/types": [
      "./dist/enderbot.js"
    ],
    "#enderbot/client": "./dist/structures/Client.js",
    "#enderbot/errors": "./dist/structures/classes/Errors.js",
    "#enderbot/functions/functions.js": "./dist/structures/utils/functions.js",
    "#enderbot/utils/*": "./dist/structures/utils/*",
    "#enderbot/classes/*": "./dist/structures/classes/*",
    "#enderbot/middlewares/*": "./dist/middlewares/*",
    "#enderbot/prisma": "./generated/prisma/index.js"
  }
}
